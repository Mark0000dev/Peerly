{
  "name": "studymate",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.less\" --max-warnings=0 --ignore-disables",
    "typecheck": "tsc --project tsconfig.app.json --noEmit && tsc --ignoreConfig --strict --noEmit --skipLibCheck --module nodenext --moduleResolution nodenext --target es2022 capacitor.config.ts && tsc --project tsconfig.spec.json --noEmit && tsc --project tsconfig.e2e.json --noEmit",
    "knip": "knip --treat-config-hints-as-errors",
    "check": "node tooling/font-watcher-patch.mjs after && npm run contracts:check && npm run format:check && npm run lint && npm run lint:styles && npm run knip && npm run typecheck && npm run test:tooling && npm run test:unit && npm run build && npm run test:public && npm run test:integration && npm run test:fullstack",
    "native:add:android": "npm run build && cap add android",
    "native:add:ios": "npm run build && cap add ios",
    "native:sync": "npm run build && cap sync",
    "native:android": "cap open android",
    "native:ios": "cap open ios",
    "prepare": "cd .. && husky frontend/.husky",
    "test:tooling": "node --test tooling/*.test.mjs",
    "test:unit": "ng test --watch=false",
    "test:integration": "node tooling/browser-gate.mjs test",
    "test:integration:update": "node tooling/browser-gate.mjs test --update-snapshots",
    "test:integration:report": "playwright show-report",
    "test": "npm run test:unit && npm run test:integration",
    "contracts:generate": "node tooling/contracts.mjs --write",
    "contracts:check": "node tooling/contracts.mjs",
    "test:fullstack": "node tooling/fullstack-matrix.mjs",
    "test:public": "STUDYMATE_STATIC_BUILD=1 node tooling/browser-gate.mjs test",
    "postinstall": "node tooling/font-watcher-patch.mjs before && patch-package --error-on-fail && node tooling/font-watcher-patch.mjs after",
    "diagnose:font-watcher": "node tooling/font-watcher-repro.mjs"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-server": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/ssr": "22.2.6",
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/m-plus-rounded-1c": "5.3.0",
    "@ng-web-apis/universal": "5.4.1",
    "@taiga-ui/cdk": "5.31.0",
    "@taiga-ui/core": "5.31.0",
    "@taiga-ui/i18n": "5.31.0",
    "@taiga-ui/icons": "5.31.0",
    "@taiga-ui/kit": "5.31.0",
    "@taiga-ui/layout": "5.31.0",
    "@taiga-ui/styles": "5.31.0",
    "@tanstack/angular-query-experimental": "5.106.1",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.4",
    "@capacitor/cli": "8.6.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-playwright": "2.12.2",
    "husky": "9.1.7",
    "knip": "6.44.1",
    "less": "4.9.1",
    "patch-package": "8.0.1",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard-less": "4.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "overrides": {
    "@taiga-ui/font-watcher": "0.6.0",
    "eslint-plugin-functional@10.0.1": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
