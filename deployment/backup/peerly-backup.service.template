[Unit]
Description=Peerly PostgreSQL/media encrypted backup with streamed readback
After=network-online.target
Wants=network-online.target
OnFailure=peerly-backup-failed.service

[Service]
Type=oneshot
User=peerly-backup
Group=peerly-backup
StateDirectory=peerly-backup
StateDirectoryMode=0700
WorkingDirectory=@@BACKUP_RELEASE@@
Environment=PYTHONPATH=@@BACKUP_RELEASE@@
Environment=PEERLY_BACKUP_PYTHON=@@BACKUP_PYTHON@@
Environment=HOME=/nonexistent
Environment=PYTHONNOUSERSITE=1
LoadCredential=plan:/etc/peerly-backup/plan.json
LoadCredential=source-request:/etc/peerly-backup/source-request.json
LoadCredential=pgpass:/etc/peerly-backup/pgpass
LoadCredential=rclone:/etc/peerly-backup/rclone.conf
@@BACKUP_OPTIONAL_CA@@
ExecStart=/bin/sh @@BACKUP_RELEASE@@/deployment/backup/run-installed-backup.sh
ExecStopPost=@@BACKUP_PYTHON@@ -s -B -m deployment.backup.backup_status --state /var/lib/peerly-backup --output /var/lib/peerly-backup-metrics/backup.prom
ReadWritePaths=/var/lib/peerly-backup-metrics
TimeoutStartSec=35min
TimeoutStopSec=10s
KillMode=control-group
Restart=no
UMask=0077
MemoryMax=512M
MemorySwapMax=0
CPUQuota=50%
TasksMax=64
LimitNOFILE=128
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=peerly-backup
