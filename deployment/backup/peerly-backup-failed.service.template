[Unit]
Description=Publish Peerly backup failure without loading backup credentials
After=peerly-backup.service

[Service]
Type=oneshot
User=peerly-backup
Group=peerly-backup
StateDirectory=peerly-backup
StateDirectoryMode=0700
WorkingDirectory=@@BACKUP_RELEASE@@
Environment=PYTHONPATH=@@BACKUP_RELEASE@@
Environment=HOME=/nonexistent
Environment=PYTHONNOUSERSITE=1
ExecStart=@@BACKUP_PYTHON@@ -s -B -m deployment.backup.backup_status --state /var/lib/peerly-backup --output /var/lib/peerly-backup-metrics/backup.prom --unit-result exit-code
ReadWritePaths=/var/lib/peerly-backup-metrics
TimeoutStartSec=10s
TimeoutStopSec=3s
KillMode=control-group
Restart=no
UMask=0077
MemoryMax=64M
MemorySwapMax=0
CPUQuota=10%
TasksMax=16
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal
SyslogIdentifier=peerly-backup-status
