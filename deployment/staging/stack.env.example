# Shape only. Filled credentials stay outside the repository and build context.
# Pin published, verified image manifests before deployment.
PEERLY_BACKEND_IMAGE=ghcr.io/mark0000dev/peerly-backend@sha256:REPLACE_WITH_VERIFIED_DIGEST
PEERLY_FRONTEND_IMAGE=ghcr.io/mark0000dev/peerly-frontend@sha256:REPLACE_WITH_VERIFIED_DIGEST
PEERLY_HOST=peerly-staging.aleksei-orlov.dev
PEERLY_PROXY_NETWORK=proxy
PEERLY_HTTPS_ENTRYPOINT=REPLACE_WITH_EXISTING_ENTRYPOINT
PEERLY_TLS_RESOLVER=REPLACE_WITH_EXISTING_RESOLVER
PEERLY_TRUSTED_PROXY_IPS=REPLACE_WITH_EXACT_TRAEFIK_IPS

# The owner explicitly selected ordinary non-TLS access for this shared instance.
# Credentials in a URL must be percent-encoded; use only the staging database.
PEERLY_DATABASE_URL=postgresql+asyncpg://replace-user:replace-password@postgres.example.test:5432/peerly_staging?ssl=disable
PEERLY_MIGRATION_DATABASE_URL=postgresql+asyncpg://replace-migration-user:replace-password@postgres.example.test:5432/peerly_staging?ssl=disable
PEERLY_GOOGLE_CLIENT_ID=REPLACE_WITH_STAGING_CLIENT_ID
PEERLY_GOOGLE_CLIENT_SECRET=REPLACE_WITH_STAGING_CLIENT_SECRET
PEERLY_ENVELOPE_KEY=REPLACE_WITH_FIRST_RANDOM_32_BYTE_HEX_KEY
PEERLY_BROWSER_SIGNING_KEY=REPLACE_WITH_SECOND_RANDOM_32_BYTE_HEX_KEY
PEERLY_CODE_KEY=REPLACE_WITH_THIRD_RANDOM_32_BYTE_HEX_KEY

PEERLY_S3_ENDPOINT=https://s3.cloud.ru
PEERLY_S3_BUCKET=peerly-staging
PEERLY_S3_REGION=ru-central-1
PEERLY_S3_ACCESS_KEY_ID=REPLACE_WITH_TENANT_PREFIXED_KEY_ID
PEERLY_S3_SECRET_ACCESS_KEY=REPLACE_WITH_STAGING_SECRET
PEERLY_SMTP_HOST=smtp-relay.brevo.com
PEERLY_SMTP_PORT=587
PEERLY_SMTP_MODE=starttls
PEERLY_SMTP_USERNAME=REPLACE_WITH_SMTP_LOGIN
PEERLY_SMTP_PASSWORD=REPLACE_WITH_SMTP_KEY
PEERLY_SMTP_SENDER=REPLACE_WITH_VERIFIED_SENDER
PEERLY_SMTP_REPLY_TO=REPLACE_WITH_SUPPLIED_SUPPORT_ADDRESS
