      },
      "targets": [
        {
          "refId": "A",
          "expr": "(worker_ai_circuit_open{job=\"peerly-app-metrics\",deployment_environment_name=~\"$environment\"}) and on (job,instance,service_name,service_version,deployment_environment_name) (worker_ai_queue_sample_fresh{job=\"peerly-app-metrics\",service_name=\"studymate-ai-worker\",deployment_environment_name=~\"$environment\"} == 1)",
          "legendFormat": "{{http_route}}{{outcome}}{{worker}}{{maintenance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "Fresh queue samples only; absent/stale is unknown, never zero. Separate freshness/age panels expose sampler health."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Collector queue utilization",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_exporter_queue_size{job=\"peerly-collector\",deployment_environment_name=~\"$environment\"} / otelcol_exporter_queue_capacity{job=\"peerly-collector\",deployment_environment_name=~\"$environment\"}",
          "legendFormat": "{{http_route}}{{outcome}}{{worker}}{{maintenance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Namespace filesystem free fraction \u2014 root and Tempo WAL",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum without (state) (system_filesystem_usage_bytes{job=\"peerly-app-metrics\",service_name=\"peerly-collector-capacity\",deployment_environment_name=~\"$environment\",mountpoint=\"/\",state=\"free\"}) / sum without (state) (system_filesystem_usage_bytes{job=\"peerly-app-metrics\",service_name=\"peerly-collector-capacity\",deployment_environment_name=~\"$environment\",mountpoint=\"/\"})",
          "legendFormat": "root overlay"
        },
        {
          "refId": "B",
          "expr": "sum without (state) (system_filesystem_usage_bytes{job=\"peerly-app-metrics\",service_name=\"peerly-collector-capacity\",deployment_environment_name=~\"$environment\",mountpoint=\"/var/tempo-capacity\",state=\"free\"}) / sum without (state) (system_filesystem_usage_bytes{job=\"peerly-app-metrics\",service_name=\"peerly-collector-capacity\",deployment_environment_name=~\"$environment\",mountpoint=\"/var/tempo-capacity\"})",
          "legendFormat": "Tempo backing filesystem"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "Only collector overlay backing filesystem and readonly Tempo data statfs; no host CPU/RAM or other mountpoints. Free excludes reserved bytes."
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "AI occupied slot \u2014 fresh samples only",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
