{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Existing inventoried Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "peerly-technical-v1",
  "title": "Peerly \u00b7 technical signals",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "peerly",
    "technical"
  ],
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(http_server_requests_total{job=\"peerly-app-metrics\"}, deployment_environment_name)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "REST requests / second",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route) (rate(http_server_requests_total{job=\"peerly-app-metrics\",deployment_environment_name=~\"$environment\",http_route!=\"/api/v1/events\",http_route!~\"^/api/(health|ready)$\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}{{outcome}}{{worker}}{{maintenance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "REST server error ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_total{job=\"peerly-app-metrics\",deployment_environment_name=~\"$environment\",http_response_status_code=~\"5..\",http_route!=\"/api/v1/events\",http_route!~\"^/api/(health|ready)$\"}[$__rate_interval])) / sum(rate(http_server_requests_total{job=\"peerly-app-metrics\",deployment_environment_name=~\"$environment\",http_route!=\"/api/v1/events\",http_route!~\"^/api/(health|ready)$\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}{{outcome}}{{worker}}{{maintenance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "REST p95 duration (seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le,http_route) (rate(http_server_request_duration_seconds_bucket{job=\"peerly-app-metrics\",deployment_environment_name=~\"$environment\",http_route!=\"/api/v1/events\",http_route!~\"^/api/(health|ready)$\"}[$__rate_interval])))",
          "legendFormat": "{{http_route}}{{outcome}}{{worker}}{{maintenance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Email worker steps by outcome \u2014 not inbox delivery",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(worker_email_steps_total{job=\"peerly-app-metrics\",deployment_environment_name=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}{{outcome}}{{worker}}{{maintenance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Media worker steps",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (worker,outcome) (rate(worker_media_steps_total{job=\"peerly-app-metrics\",deployment_environment_name=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}{{outcome}}{{worker}}{{maintenance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request expiry steps",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(worker_requests_expiry_steps_total{job=\"peerly-app-metrics\",deployment_environment_name=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}{{outcome}}{{worker}}{{maintenance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Change maintenance steps",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (maintenance,outcome) (rate(worker_changes_steps_total{job=\"peerly-app-metrics\",deployment_environment_name=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}{{outcome}}{{worker}}{{maintenance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "AI queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(worker_ai_queue_depth{job=\"peerly-app-metrics\",deployment_environment_name=~\"$environment\"}) and on (job,instance,service_name,service_version,deployment_environment_name) (worker_ai_queue_sample_fresh{job=\"peerly-app-metrics\",service_name=\"studymate-ai-worker\",deployment_environment_name=~\"$environment\"} == 1)",
          "legendFormat": "{{http_route}}{{outcome}}{{worker}}{{maintenance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "Fresh queue samples only; absent/stale is unknown, never zero. Separate freshness/age panels expose sampler health."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "AI oldest queued age",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(worker_ai_queue_oldest_seconds{job=\"peerly-app-metrics\",deployment_environment_name=~\"$environment\"}) and on (job,instance,service_name,service_version,deployment_environment_name) (worker_ai_queue_sample_fresh{job=\"peerly-app-metrics\",service_name=\"studymate-ai-worker\",deployment_environment_name=~\"$environment\"} == 1)",
          "legendFormat": "{{http_route}}{{outcome}}{{worker}}{{maintenance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "Fresh queue samples only; absent/stale is unknown, never zero. Separate freshness/age panels expose sampler health."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "AI circuit open (1=open)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
