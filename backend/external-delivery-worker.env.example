# Explicit worker-only configuration. Never copy real credentials into Git.
DATABASE_URL=postgresql+asyncpg://replace-user:replace-password@replace-host/replace-db
# At least one actual destination must be configured; omitted sinks remain pending.
UMAMI__REVISION=1
UMAMI__ORIGIN=https://analytics.example.test
UMAMI__WEBSITE_ID=00000000-0000-4000-8000-000000000001
# Configure SUPPORT only after its exact private destination is approved.
# TELEGRAM_SUPPORT__REVISION=1
# TELEGRAM_SUPPORT__CHAT_ID=-1000000000001
# TELEGRAM_SUPPORT__OPERATOR_ORIGIN=https://peerly.aleksei-orlov.dev
# TELEGRAM_SUPPORT__TOKEN=replace-with-private-bot-token
# TELEGRAM_SUPPORT__TOPIC_ID=1
# Optional owned OTLP providers; no application telemetry auto-configuration.
# OBSERVABILITY__COLLECTOR_ORIGIN=http://collector:4318
# OBSERVABILITY__ENVIRONMENT=staging
# OBSERVABILITY__RELEASE=replace-source-sha
