# Explicit process environment only; this file is a template, never auto-loaded.
# DATABASE_URL targets the dedicated Peerly application DB, not default_db.
DATABASE_URL=postgresql+asyncpg://REPLACE_ROLE:REPLACE_PASSWORD@REPLACE_HOST/peerly_staging?ssl=disable
RUNTIME__EXECUTABLE=/usr/local/lib/peerly-codex/vendor/x86_64-unknown-linux-musl/bin/codex
RUNTIME__EXPECTED_VERSION=codex-cli 0.167.0
RUNTIME__EXPECTED_SHA256=cdcb45aaa01d0f14e298985e09465aebccd47f64ecd298aea44814af7b62bbda
RUNTIME__MODEL=REPLACE_WITH_ACCEPTED_MODEL
RUNTIME__CREDENTIAL_DIRECTORY=/var/lib/peerly-ai/credentials
RUNTIME__WORKSPACES_ROOT=/var/lib/peerly-ai/jobs
RUNTIME__EXPECTED_ACCOUNT=REPLACE_OWNER_PROVISIONED_ACCOUNT_BINDING
RUNTIME__EXPECTED_LOGIN_OWNER=REPLACE_OWNER_PROVISIONED_LOGIN_OWNER
RUNTIME__EXPECTED_OAUTH_ISSUER=REPLACE_OWNER_PROVISIONED_OAUTH_ISSUER
RUNTIME__EXPECTED_OAUTH_CLIENT_ID=REPLACE_OWNER_PROVISIONED_OAUTH_CLIENT_ID
RUNTIME__ACCEPTANCE_ARTIFACT=/var/lib/peerly-ai/acceptance/receipt.json
RUNTIME__BUBBLEWRAP=/usr/local/lib/peerly-codex/vendor/x86_64-unknown-linux-musl/codex-resources/bwrap
RUNTIME__PRLIMIT=/usr/bin/prlimit
# Supply MEDIA__ENDPOINT_ORIGIN, REGION, BUCKET, ACCESS_KEY_ID, SECRET_ACCESS_KEY
# using the same validated MediaConfiguration as the API/media worker.
# No OPENAI_API_KEY, CODEX_API_KEY, developer HOME or developer CODEX_HOME.
