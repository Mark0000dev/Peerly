# Synthetic placeholders only; never commit a filled .env.worker.
DATABASE_URL=postgresql+asyncpg://replace-user:replace-password@postgres.example.test:5432/peerly
CODE_KEY=REPLACE_WITH_64_HEX_CHARACTERS
ENVELOPE_KEY=REPLACE_WITH_A_DIFFERENT_64_HEX_KEY
SMTP__HOSTNAME=smtp.example.test
SMTP__PORT=587
SMTP__MODE=starttls
SMTP__USERNAME=replace-me
SMTP__PASSWORD=replace-me
# Choose a sender verified with your provider; this example is not a real sender.
SMTP__SENDER=verify@example.test
# Optional: choose a monitored reply inbox. Omit this setting to omit Reply-To.
# SMTP__REPLY_TO=support@example.test
